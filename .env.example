# ---------------------------------------------------------------------------
# Chic by Sisters Clinic — booking website
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
#
# ⚠️  Never commit `.env.local` (or any file containing real secrets).
#     Anything prefixed with NEXT_PUBLIC_ is bundled into the browser —
#     never put a secret in a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------

# --- Public site ------------------------------------------------------------
# Canonical production URL, used for metadata, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Clinic contact details -------------------------------------------------
# These stay EMPTY until the clinic supplies the real information.
# The site renders an elegant "to be confirmed" placeholder while they are empty
# and switches to real contact details automatically once they are set.
NEXT_PUBLIC_CLINIC_PHONE=
NEXT_PUBLIC_CLINIC_WHATSAPP=
NEXT_PUBLIC_CLINIC_ADDRESS=
NEXT_PUBLIC_CLINIC_MAP_QUERY=
# Optional: full Google Maps directions link (falls back to a Maps search URL).
NEXT_PUBLIC_CLINIC_DIRECTIONS_URL=
NEXT_PUBLIC_CLINIC_EMAIL=

# --- Supabase (optional — demo mode is used while these are empty) ----------
# Client-safe values only. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Business Cloud API (server-only) ------------------------------
# Used later for automated confirmations, reschedule/cancel notices and
# "running late" updates. The public "Chat on WhatsApp" button only needs
# NEXT_PUBLIC_CLINIC_WHATSAPP above (a plain wa.me link, no API involved).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Booking rules ----------------------------------------------------------
# Slot length offered in the calendar (minutes).
NEXT_PUBLIC_BOOKING_SLOT_INTERVAL=30
# Minimum notice before an appointment can be booked (minutes).
NEXT_PUBLIC_BOOKING_LEAD_TIME=120
# How far ahead customers may book (days).
NEXT_PUBLIC_BOOKING_HORIZON_DAYS=60

# --- Appointment management -------------------------------------------------
# Length of the random, unguessable token in the management link
# (32 bytes hex-encoded). Do not lower below 16.
APPOINTMENT_TOKEN_BYTES=32
